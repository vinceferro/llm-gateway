{
  "name": "llm-gateway",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Thin local OpenAI-compatible gateway: multi-provider routing with sticky cache-affinity, fallback chains, per-project cost ledger.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/main.ts",
    "start": "npm run dev",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "smoke": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/smoke.ts",
    "hash-key": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/hash-key.ts",
    "bench:summarize": "node --disable-warning=ExperimentalWarning --experimental-strip-types bench/summarize.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
